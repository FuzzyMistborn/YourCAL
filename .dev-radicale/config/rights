[root]
user: .*
collection:
permissions: R

[principal]
user: .+
collection: {user}
permissions: RW

[calendars]
user: .+
collection: {user}/[^/]+
permissions: rw

[shared-personal-for-shareduser]
user: shareduser
collection: testuser/personal
permissions: rw
