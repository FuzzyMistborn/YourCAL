# Copy to .env and fill in. `.env` itself is gitignored.

# Required. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Optional. Comma-separated CalDAV server hostnames this app may connect
# to (e.g. caldav.example.com,192.168.1.50). Unset = any host allowed.
ALLOWED_CALDAV_HOSTS=

# Optional. How long a login lasts, in seconds. Default 86400 (24h).
SESSION_TTL_DAYS=1

# Optional. See AGENTS.md's "SQLite read-cache" section.
CACHE_ENABLED=false
CACHE_SYNC_TTL_MS=30000
